    <!-- Sky birds animation (featured products slide) -->
    <style>
        .bend.niceties.preview-1 { position: relative; }
        .sky-birds { position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 6; display: none; }
        .sky-birds .flock { position: absolute; left: 0; top: 0; width: 0; height: 0;
            animation: flockMove 24s linear infinite; }
        .sky-birds .bird.small { width: 10px; height: 6px; }
        .sky-birds .bird { position: absolute; width: 15px; height: 9px; }
        .sky-birds .bird svg { display: block; width: 100%; height: 100%; overflow: visible; }
        .sky-birds .wg { fill: none; stroke: #33465c; stroke-width: 3; stroke-linecap: round; transform-box: fill-box; }
        .sky-birds .wl { transform-origin: right center; animation: flapL .5s ease-in-out infinite; }
        .sky-birds .wr { transform-origin: left center;  animation: flapR .5s ease-in-out infinite; }
        @keyframes flapL { 0%,100% { transform: rotate(8deg); }  50% { transform: rotate(40deg); } }
        @keyframes flapR { 0%,100% { transform: rotate(-8deg); } 50% { transform: rotate(-40deg); } }
        @keyframes flockMove {
            0%   { left: -10%; top: 50%; opacity: 0; }
            12%  { opacity: 1; }
            88%  { opacity: 1; }
            100% { left: 96%;  top: 2%;  opacity: 0; }
        }
        /* Clickable product tiles on the Featured Products slide */
        .slide-links { position: absolute; inset: 0; z-index: 8; display: none; }
        .slide-links a { position: absolute; top: 47.6%; width: 12.63%; height: 37.5%; display: block; cursor: pointer;
            background-image: url(img/slider/1-4.jpg?v=15);
            background-size: 791.77% 266.67%;      /* draw the slide at full size inside each tile box */
            background-repeat: no-repeat;
            transform-origin: center center;
            transition: transform .3s ease, box-shadow .3s ease;
        }
        .slide-links a:hover {
            transform: scale(1.2);                 /* zoom the tile image on hover (no border) */
            box-shadow: 0 18px 42px rgba(10,36,80,0.35);
            z-index: 20;
        }
        /* Headline / punchline overlay on the Featured Products slide */
        .slide-headline { position: absolute; left: 3.4%; top: 12%; z-index: 9; display: none; max-width: 60%; }
        .slide-headline .fh-badge { display: inline-flex; align-items: center; gap: 7px; background: linear-gradient(90deg,#1e6fd6,#31a9e0); color: #fff; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; padding: 5px 14px; border-radius: 30px; box-shadow: 0 4px 14px rgba(30,111,214,0.4); margin-bottom: 12px; }
        .slide-headline .fh-badge i { font-size: 12px; }
        .slide-headline h2 { margin: 0; font-size: clamp(20px, 3.1vw, 40px); line-height: 1.18; font-weight: 800; color: #12233f; text-shadow: 0 1px 12px rgba(255,255,255,0.55); }
        .slide-headline h2 span { color: #1e6fd6; }
        @media (max-width: 767px) {
            .slide-headline { top: 4%; max-width: 88%; }
            .slide-headline .fh-badge { font-size: 10px; padding: 4px 10px; margin-bottom: 7px; }
        }
    </style>
</head>

