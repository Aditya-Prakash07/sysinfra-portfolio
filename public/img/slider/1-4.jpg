                    <script>
                        (function () {
                            function initBirds() {
                                var box = document.getElementById('skyBirds');
                                var slider = document.getElementById('ensign-nivoslider-3');
                                if (!box || !slider) { return setTimeout(initBirds, 400); }
                                var links = document.getElementById('featuredLinks');
                                var headline = document.getElementById('featuredHeadline');

                                /* ---- Per-slide auto-advance timing ---- */
                                var FEATURED_MS = 20000;   /* 1st (featured) slide stays this long */
                                var OTHER_MS = 10000;      /* every other slide */
                                var advTimer = null, lastSrc = '', paused = false;
                                function curSrc() {
                                    var im = slider.querySelector('img.nivo-main-image') || slider.querySelector('img');
                                    return im ? (im.getAttribute('src') || '') : '';
                                }
                                function schedule() {
                                    clearTimeout(advTimer);
                                    if (paused) { return; }
                                    var t = curSrc().indexOf('1-4.jpg') > -1 ? FEATURED_MS : OTHER_MS;
                                    advTimer = setTimeout(function () {
                                        var nx = slider.querySelector('.nivo-nextNav');
                                        if (nx) { nx.click(); }
                                    }, t);
                                }
                                /* pause on hover, resume on leave */
                                slider.addEventListener('mouseenter', function () { paused = true; clearTimeout(advTimer); });
                                slider.addEventListener('mouseleave', function () { paused = false; schedule(); });

                                function upd() {
                                    var src = curSrc();
                                    var on = src.indexOf('1-4.jpg') > -1;
                                    box.style.display = 'block';                 /* birds on every slide */
                                    if (links) links.style.display = on ? 'block' : 'none'; /* clickable tiles only on featured slide */
                                    if (headline) headline.style.display = on ? 'block' : 'none'; /* punchline only on featured slide */
                                    if (src && src !== lastSrc) { lastSrc = src; schedule(); } /* slide changed -> reset its timer */
                                }
                                try { new MutationObserver(upd).observe(slider, { attributes: true, subtree: true, attributeFilter: ['src', 'style', 'class'] }); } catch (e) {}
                                setInterval(upd, 500); upd();
                            }
                            if (document.readyState !== 'loading') { initBirds(); }
                            else { document.addEventListener('DOMContentLoaded', initBirds); }
                        })();
                    </script>
